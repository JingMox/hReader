{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["docs/**"],
  "vitest": {
    "config": ["vitest.config.ts", "packages/*/vitest.config.ts"]
  },
  "eslint": {
    "config": ["eslint.config.mjs"]
  },
  "prettier": {
    "config": [".prettierrc.json"]
  },
  "workspaces": {
    "packages/core": {
      "entry": ["fixtures/*.mjs", "tests/**/*.ts"]
    },
    "packages/cli": {
      "entry": [
        "src/args/index.ts",
        "src/input.ts",
        "src/output.ts",
        "src/run.ts",
        "src/usage.ts",
        "src/exit-codes.ts",
        "src/commands/*.ts",
        "fixtures/*.mjs",
        "scripts/*.ts",
        "scripts/*.mjs",
        "tests/**/*.ts"
      ]
    },
    ".": {
      "entry": ["skills/hreader/scripts/hr.mjs", "scripts/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/main.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts"]
    },
    "packages/mcp-server": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/pi-extension": {
      "entry": ["pi-hreader.ts", "tests/**/*.ts"]
    },
    "packages/dsh-bundle": {
      "entry": ["tests/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@deepseek-ai/dsh-attachment", "@deepseek-ai/dsh-package-manifest"]
    },
    "packages/desktop": {
      "entry": ["webview/*.js"]
    }
  },
  "ignoreIssues": {
    "packages/core/src/ops/patchNode/attrs.ts": ["exports"],
    "packages/app/src/boot.ts": ["exports"],
    "packages/app/src/main.ts": ["exports"]
  }
}
