{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hReader",
  "version": "0.0.0",
  "identifier": "com.hreader.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "hReader 阅读器文档",
        "role": "Viewer",
        "mimeType": "text/html"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
