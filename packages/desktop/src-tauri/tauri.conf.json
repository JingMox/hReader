{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hReader",
  "version": "1.0.0",
  "identifier": "com.hreader.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/**/*"],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "hReader HTML Document",
        "role": "Viewer",
        "mimeType": "text/html"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
