{
  "name": "@hreader/dsh-bundle",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@hreader/core": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
