{
  "name": "hreader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -C packages/app build && pnpm -C packages/mcp-server build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm depcruise && pnpm knip",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages",
    "knip": "knip",
    "smoke:pi": "node scripts/smoke-pi-extension.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "knip": "^5.81.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  }
}
