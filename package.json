{
  "name": "hreader",
  "version": "1.0.0",
  "description": "Local-first single-file HTML reader, desktop notes workbench, and surgical DOM authoring protocol for AI agents.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JingMox/hReader.git"
  },
  "homepage": "https://github.com/JingMox/hReader#readme",
  "bugs": {
    "url": "https://github.com/JingMox/hReader/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -C packages/app build && pnpm -C packages/cli build && pnpm -C packages/mcp-server build && pnpm -C packages/dsh-bundle build",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages",
    "desktop:build": "pnpm --dir packages/desktop run build",
    "desktop:check": "bash packages/desktop/scripts/check.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint:sh": "if command -v shellcheck >/dev/null 2>&1; then find scripts packages -name \"*.sh\" -not -path \"*/node_modules/*\" -not -path \"*/src-tauri/*\" -print0 | xargs -0 shellcheck -x -S warning; else echo \"lint:sh: shellcheck 未安装，跳过（CI 已装并检查；本地 brew/apt install shellcheck 可复现）\"; fi",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "skill:pack": "node scripts/pack-skill.mjs",
    "smoke:dsh": "node scripts/smoke-dsh.ts",
    "smoke:pi": "node scripts/smoke-pi-extension.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/print-e2e.ts && node scripts/foreign-sandbox-e2e.ts",
    "test:mutation": "stryker run",
    "theme:check": "node scripts/check-theme-contrast.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:sh && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm theme:check && pnpm depcruise && pnpm knip"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.1",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "knip": "^5.81.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2",
    "vitest": "catalog:"
  }
}
